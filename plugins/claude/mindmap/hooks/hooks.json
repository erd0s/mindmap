{
  "description": "Keep active Mindmap projects synchronized with agent session lifecycle events.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" --host claude", "timeout": 15}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" --host claude", "timeout": 30}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" --host claude", "timeout": 30}
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" --host claude", "timeout": 15}
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" --host claude", "timeout": 15}
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/run_hook.sh\" --host claude", "timeout": 3}
        ]
      }
    ]
  }
}
